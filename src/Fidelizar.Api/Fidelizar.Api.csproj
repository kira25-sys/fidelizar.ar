<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Fidelizar.Application\Fidelizar.Application.csproj" />
    <ProjectReference Include="..\Fidelizar.Infrastructure\Fidelizar.Infrastructure.csproj" />
    <ProjectReference Include="..\Fidelizar.Shared\Fidelizar.Shared.csproj" />
    <!--
      ARCHITECTURE §3 "One deployable unit": Api serves the compiled WebAssembly client as static
      files from the same origin. This reference is what brings the client's published output into
      Api's wwwroot (_framework/ and the rest) — it is a hosting arrow, not a layering one, so it
      does not let Api call into Client code (Client only exposes Blazor components).
    -->
    <ProjectReference Include="..\Fidelizar.Client\Fidelizar.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!--
      Task-authorized (F1-03, ARCHITECTURE §8 names this exact mechanism: "JwtBearer se configura
      para leer el token de la cookie via OnMessageReceived"; nuget.org, MIT). Not part of the
      ASP.NET Core shared framework (confirmed by inspecting the installed shared framework
      directory — only Microsoft.AspNetCore.Identity.dll ships there, not this). Also supplies
      Microsoft.IdentityModel.JsonWebTokens/Tokens transitively, used by JwtTokenService to sign
      and issue the token this handler later validates.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>00d761ed-0318-4878-93ea-637eed48a152</UserSecretsId>
  </PropertyGroup>

</Project>

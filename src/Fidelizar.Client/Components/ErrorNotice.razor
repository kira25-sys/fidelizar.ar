@* The one Spanish error/offline treatment (ROADMAP F1-04c) — every screen drops this in. *@
@using Fidelizar.Client.Api

@if (Problem is not null)
{
    <div class="error-notice" role="alert">
        <span class="error-notice__icon" aria-hidden="true">⚠</span>
        <div class="error-notice__body">
            <p class="error-notice__message">@Problem.Message</p>
            @if (Problem.Details.Count > 0)
            {
                <ul class="error-notice__details">
                    @foreach (var detail in Problem.Details)
                    {
                        <li>@detail.Issue</li>
                    }
                </ul>
            }
        </div>
        @if (OnRetry.HasDelegate)
        {
            <button type="button" class="btn btn--secondary error-notice__retry" @onclick="OnRetry">
                Reintentar
            </button>
        }
    </div>
}

@code {
    [Parameter] public ApiProblem? Problem { get; set; }

    /// <summary>Unbound: no retry button shown.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }
}

@* S4 Registrar canje (FLOW-S2-S5.md §3) — a native <dialog> over S3, never a page navigation. *@
@using Fidelizar.Client.Api
@using Fidelizar.Client.Formatting
@using Fidelizar.Shared.Movimientos
@using System.Net
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<dialog class="canje" @ref="_dialogo" @onclose="AlCerrar" aria-labelledby="canje-titulo">
    <form method="dialog" class="canje__cerrar-form">
        <button type="submit" class="canje__cerrar" aria-label="Cerrar">×</button>
    </form>

    <h2 id="canje-titulo" class="canje__titulo">Registrar canje — @Nombre</h2>

    <p class="canje__saldo">Saldo disponible: <span class="amount">@MoneyFormatter.Format(Saldo)</span></p>
    <CorteBadge CorteFecha="CorteFecha" MostrarDetalle="true" />

    @if (_banner is not null)
    {
        <div class="canje__banner canje__banner--@(_banner.Tono)" role="alert" tabindex="-1" @ref="_bannerRef">
            <p>@_banner.Mensaje</p>
            @if (_banner.OfreceIngresar)
            {
                <button type="button" class="btn btn--secondary" @onclick="IrAIngresar">Iniciar sesión</button>
            }
        </div>
    }

    <form class="canje__form" novalidate @onsubmit="ConfirmarAsync" @onsubmit:preventDefault="true">
        <div class="field">
            <label for="canje-monto">Monto</label>
            <div class="canje__monto">
                <span class="canje__signo" aria-hidden="true">$</span>
                <input
                    id="canje-monto"
                    class="input"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    @bind="_montoTexto"
                    @bind:event="oninput"
                    @ref="_montoInput"
                    aria-invalid="@(_errorMonto is null ? "false" : "true")"
                    aria-describedby="canje-monto-ayuda @(_errorMonto is null ? "" : "canje-monto-error")" />
            </div>
            <span id="canje-monto-ayuda" class="canje__ayuda">Ej: 1.500 = mil quinientos pesos</span>
            @if (_errorMonto is not null)
            {
                <span id="canje-monto-error" class="field-error">@_errorMonto</span>
            }
        </div>

        <div class="field">
            <label for="canje-fecha">Fecha</label>
            <input
                id="canje-fecha"
                class="input"
                type="date"
                max="@Hoy.ToString("yyyy-MM-dd")"
                @bind="_fecha"
                @bind:event="oninput"
                @ref="_fechaInput"
                aria-invalid="@(_errorFecha is null ? "false" : "true")"
                aria-describedby="@(_errorFecha is null ? null : "canje-fecha-error")" />
            @if (_errorFecha is not null)
            {
                <span id="canje-fecha-error" class="field-error">@_errorFecha</span>
            }
        </div>

        <fieldset class="field canje__motivos" aria-describedby="@(_errorMotivo is null ? null : "canje-motivo-error")">
            <legend>Motivo</legend>
            @foreach (var motivo in Presets)
            {
                <label class="canje__chip @(EsSugerido(motivo) ? "canje__chip--sugerido" : null)">
                    <input
                        type="radio"
                        name="canje-motivo"
                        value="@motivo"
                        checked="@(_motivoElegido == motivo)"
                        @onchange="() => ElegirMotivo(motivo)" />
                    <span>@motivo</span>
                </label>
            }
            <label class="canje__chip">
                <input
                    type="radio"
                    name="canje-motivo"
                    value="@MotivoOtro"
                    checked="@(_motivoElegido == MotivoOtro)"
                    @onchange="() => ElegirMotivo(MotivoOtro)" />
                <span>Otro…</span>
            </label>

            @if (_motivoElegido == MotivoOtro)
            {
                <input
                    id="canje-motivo-otro"
                    class="input canje__otro"
                    type="text"
                    maxlength="200"
                    aria-label="Escribí el motivo"
                    @bind="_motivoOtroTexto"
                    @bind:event="oninput"
                    @ref="_motivoOtroInput" />
            }

            @if (_errorMotivo is not null)
            {
                <span id="canje-motivo-error" class="field-error">@_errorMotivo</span>
            }
        </fieldset>

        <div class="canje__acciones">
            <button type="button" class="btn btn--secondary" @onclick="CerrarAsync">Cancelar</button>
            <button
                type="submit"
                class="btn btn--primary"
                disabled="@(_enviando || _bloqueadoPorRevision)"
                aria-disabled="@((_enviando || _bloqueadoPorRevision) ? "true" : "false")"
                aria-busy="@(_enviando ? "true" : "false")">
                Confirmar canje
            </button>
        </div>
    </form>
</dialog>

@code {
    private const string MotivoOtro = "Otro…";
    private const string MotivoRetroactivo = "Carga retroactiva";

    private static readonly string[] Presets =
    [
        "Descuento en la compra",
        MotivoRetroactivo,
        "Pedido especial",
    ];

    [Parameter, EditorRequired] public int MiembroId { get; set; }
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter, EditorRequired] public decimal Saldo { get; set; }
    [Parameter, EditorRequired] public DateOnly CorteFecha { get; set; }

    /// <summary>Fires on a 200 — S3 updates its balance figure from the response.</summary>
    [Parameter] public EventCallback<CanjeResponse> OnCanjeRegistrado { get; set; }

    /// <summary>Fires when the dialog closes, whatever closed it — S3 returns focus to its
    /// own button (DESIGN-SYSTEM §9.2).</summary>
    [Parameter] public EventCallback OnCerrado { get; set; }

    private ElementReference _dialogo;
    private ElementReference _montoInput;
    private ElementReference _fechaInput;
    private ElementReference _motivoOtroInput;
    private ElementReference _bannerRef;
    private IJSObjectReference? _modulo;

    // The draft (FLOW-S2-S5.md §3.7): closing is not discarding, so these survive Esc/Cancelar
    // and are only cleared on success or when S3 switches to another member.
    private string _montoTexto = string.Empty;
    private DateOnly _fecha = Hoy;
    private string? _motivoElegido;
    private string _motivoOtroTexto = string.Empty;

    private string? _errorMonto;
    private string? _errorFecha;
    private string? _errorMotivo;
    private Banner? _banner;
    private bool _enviando;
    private bool _bloqueadoPorRevision;
    private bool _focoAlMonto;
    private bool _focoAlBanner;

    // One key per redemption attempt, kept across a retry of the same values so a lost response
    // cannot write a second Canje (openapi-fase1.yaml, README decision #6).
    private string? _clave;
    private (decimal Monto, DateOnly Fecha, string Motivo)? _valoresDeLaClave;

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Now);

    private sealed record Banner(string Mensaje, string Tono, bool OfreceIngresar = false);

    /// <summary>"Carga retroactiva" is highlighted — never auto-selected — while the date is in
    /// the past and nothing is chosen yet (FLOW-S2-S5.md §3.3).</summary>
    private bool EsSugerido(string motivo) =>
        motivo == MotivoRetroactivo && _fecha < Hoy && _motivoElegido is null;

    public async Task AbrirAsync()
    {
        _banner = null;
        _bloqueadoPorRevision = false;
        _errorMonto = _errorFecha = _errorMotivo = null;
        _focoAlMonto = true;

        var modulo = await ObtenerModuloAsync();
        await modulo.InvokeVoidAsync("abrirModal", _dialogo);
        StateHasChanged();
    }

    /// <summary>Drops the draft — S3 calls this when it loads a different member
    /// (FLOW-S2-S5.md §3.7: a different customer makes a stale draft misleading).</summary>
    public void LimpiarBorrador()
    {
        _montoTexto = string.Empty;
        _fecha = Hoy;
        _motivoElegido = null;
        _motivoOtroTexto = string.Empty;
        _errorMonto = _errorFecha = _errorMotivo = null;
        _banner = null;
        _bloqueadoPorRevision = false;
        _clave = null;
        _valoresDeLaClave = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focoAlMonto)
        {
            _focoAlMonto = false;
            await _montoInput.FocusAsync();
        }
        else if (_focoAlBanner)
        {
            _focoAlBanner = false;
            await _bannerRef.FocusAsync();
        }
    }

    private void ElegirMotivo(string motivo)
    {
        _motivoElegido = motivo;
        _errorMotivo = null;
    }

    private async Task CerrarAsync()
    {
        var modulo = await ObtenerModuloAsync();
        await modulo.InvokeVoidAsync("cerrar", _dialogo);
    }

    /// <summary>The single close path: Esc, the × , Cancelar and a backdrop click all end
    /// here through the native close event.</summary>
    private async Task AlCerrar() => await OnCerrado.InvokeAsync();

    private void IrAIngresar() => Navigation.NavigateTo("/ingreso");

    private async Task ConfirmarAsync()
    {
        // disabled in the markup is what stops a second Enter — DESIGN-SYSTEM §9.5.
        if (_enviando || _bloqueadoPorRevision)
        {
            return;
        }

        if (!Validar(out var monto, out var motivo))
        {
            await EnfocarPrimerError();
            return;
        }

        _enviando = true;
        _banner = null;
        StateHasChanged();

        var request = new RegistrarCanjeRequest(monto, _fecha, motivo, ClaveParaEsteIntento(monto, _fecha, motivo));
        var resultado = await ApiClient.PostAsync<RegistrarCanjeRequest, CanjeResponse>(
            $"api/miembros/{MiembroId}/canjes", request);

        _enviando = false;

        if (resultado.Success)
        {
            var respuesta = resultado.Value!;
            LimpiarBorrador();
            await CerrarAsync();
            await OnCanjeRegistrado.InvokeAsync(respuesta);
            return;
        }

        MostrarBanner(resultado.Problem!, monto);
    }

    /// <summary>
    /// A new key only when the values changed since the last attempt: identical values are a
    /// retry and must reuse it, edited values would otherwise collide as
    /// CLAVE_IDEMPOTENCIA_REUTILIZADA.
    /// </summary>
    private string ClaveParaEsteIntento(decimal monto, DateOnly fecha, string motivo)
    {
        var valores = (monto, fecha, motivo);

        if (_clave is null || _valoresDeLaClave != valores)
        {
            _clave = Guid.NewGuid().ToString();
            _valoresDeLaClave = valores;
        }

        return _clave;
    }

    private bool Validar(out decimal monto, out string motivo)
    {
        _errorMonto = _errorFecha = _errorMotivo = null;
        monto = 0m;
        motivo = string.Empty;

        if (string.IsNullOrWhiteSpace(_montoTexto))
        {
            _errorMonto = "Ingresá un monto.";
        }
        else if (!MontoTecleadoParser.TryParse(_montoTexto, out monto))
        {
            _errorMonto = "No entendimos ese monto. Escribilo en números — por ejemplo 1.500.";
        }
        else if (monto <= 0m)
        {
            _errorMonto = "El monto tiene que ser mayor a $0.";
        }

        if (_fecha > Hoy)
        {
            _errorFecha = "La fecha no puede ser posterior a hoy.";
        }

        motivo = _motivoElegido == MotivoOtro ? _motivoOtroTexto.Trim() : _motivoElegido ?? string.Empty;
        if (string.IsNullOrWhiteSpace(motivo))
        {
            _errorMotivo = "Elegí o escribí un motivo.";
        }

        return _errorMonto is null && _errorFecha is null && _errorMotivo is null;
    }

    private async Task EnfocarPrimerError()
    {
        StateHasChanged();

        if (_errorMonto is not null)
        {
            await _montoInput.FocusAsync();
        }
        else if (_errorFecha is not null)
        {
            await _fechaInput.FocusAsync();
        }
        else if (_motivoElegido == MotivoOtro)
        {
            await _motivoOtroInput.FocusAsync();
        }
    }

    /// <summary>Server rejections (FLOW-S2-S5.md §3.5) — the fields keep every value typed.</summary>
    private void MostrarBanner(ApiProblem problem, decimal montoIntentado)
    {
        _banner = problem switch
        {
            { ErrorCode: "SALDO_EN_REVISION" } => new Banner(
                $"El saldo de {Nombre} quedó en revisión mientras completabas este canje. " +
                "No se puede registrar hasta que la encargada lo revise.",
                "warning"),

            { ErrorCode: "CANJE_SUPERA_SALDO" } => new Banner(
                $"El canje ({MoneyFormatter.Format(montoIntentado)}) es mayor que el saldo de " +
                $"{Nombre} ({MoneyFormatter.Format(Saldo)}).",
                "danger"),

            { ErrorCode: "MONTO_INVALIDO" } => new Banner("El monto tiene que ser mayor a $0.", "danger"),

            { StatusCode: HttpStatusCode.Unauthorized } => new Banner(
                "Tu sesión venció. Iniciá sesión de nuevo para continuar — no perdés lo que cargaste.",
                "danger",
                OfreceIngresar: true),

            _ => new Banner(
                "No pudimos registrar el canje. Los datos que cargaste siguen acá — probá de nuevo.",
                "danger"),
        };

        _bloqueadoPorRevision = problem.ErrorCode == "SALDO_EN_REVISION";

        // A reused key is a client bug, not a retry: start the next attempt with a fresh one.
        if (problem.ErrorCode == "CLAVE_IDEMPOTENCIA_REUTILIZADA")
        {
            _clave = null;
            _valoresDeLaClave = null;
        }

        _focoAlBanner = true;
        StateHasChanged();
    }

    private async Task<IJSObjectReference> ObtenerModuloAsync() =>
        _modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialogo.js");

    public async ValueTask DisposeAsync()
    {
        if (_modulo is not null)
        {
            try
            {
                await _modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser is already gone; nothing to release.
            }
        }
    }
}

@inherits LayoutComponentBase
@inject ISessionService SessionService
@inject NavigationManager Navigation
@implements IDisposable

@* No sidebar nav: FUNCTIONAL-SPEC §1 — search is the entry point, nothing to learn. The one
   exception is S10, the owner's back office, which search cannot reach: a single link, shown to
   a Dueño only, so a cashier's header is byte for byte the one they had before. Hiding it is
   presentation — /api/usuarios and /api/sucursales are what actually refuse everyone else
   (ARCHITECTURE §8). *@

<a class="skip-link" href="#main-content">Saltar al contenido principal</a>

<header class="app-header">
    <span class="app-header__brand">Fidelizar</span>
    @if (SessionService.IsAuthenticated)
    {
        <div class="app-header__session">
            @if (EsDueno)
            {
                <a class="app-header__admin" href="/administracion">Usuarios y sucursales</a>
            }
            <span>@SessionService.Current?.NombreCompleto</span>
            <button
                type="button"
                class="btn btn--secondary"
                disabled="@_loggingOut"
                aria-busy="@(_loggingOut ? "true" : "false")"
                @onclick="HandleLogoutAsync">
                Cerrar sesión
            </button>
        </div>
    }
</header>

<main id="main-content" tabindex="-1" class="page">
    @if (_logoutProblem is not null)
    {
        <ErrorNotice Problem="_logoutProblem" OnRetry="HandleLogoutAsync" />
    }
    @Body
</main>

@code {
    private bool _loggingOut;
    private ApiProblem? _logoutProblem;

    private bool EsDueno => SessionService.Current?.Rol == Roles.Dueno;

    protected override void OnInitialized()
    {
        SessionService.Changed += OnSessionChanged;
    }

    private async Task HandleLogoutAsync()
    {
        // disabled (not just aria-busy) is what stops a second Enter — DESIGN-SYSTEM §9.5.
        if (_loggingOut)
        {
            return;
        }

        _loggingOut = true;
        _logoutProblem = null;
        StateHasChanged();

        var result = await SessionService.LogoutAsync();

        _loggingOut = false;
        _logoutProblem = result.Success ? null : result.Problem;

        if (result.Success)
        {
            // S1: end of shift lands back at the login screen, session state already cleared.
            Navigation.NavigateTo("/ingreso", replace: true);
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => SessionService.Changed -= OnSessionChanged;
}

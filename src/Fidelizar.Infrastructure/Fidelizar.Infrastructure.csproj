<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fidelizar.Domain\Fidelizar.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FidelizarDbContextFactory's design-time helpers are internal: nothing at runtime may build
      configuration behind the composition root's back. The tests need them to prove the factory
      and Fidelizar.Api read the same secret store (2026-08-20), same pattern as Domain.csproj.
    -->
    <InternalsVisibleTo Include="Fidelizar.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 (the latest available) depends on
      Microsoft.EntityFrameworkCore.Relational 10.0.4, one patch behind the 10.0.11 pulled in by
      the two references above. Pinning it explicitly here — same package, no new dependency —
      is what makes NuGet resolve one consistent version instead of emitting an MSB3277 conflict
      warning on every project that ends up referencing Fidelizar.Infrastructure.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Owner-authorized 2026-08-12 (F0-08, nuget.org, MIT): reads the padron Excel roster in
      VipPadronImporter, the same version Octaviano uses today so the port is faithful. Scoped to
      this project only — importers and adapters live in Fidelizar.Infrastructure (CLAUDE.md).
      Fidelizar.Infrastructure.Tests gets it transitively through the ProjectReference below to
      build .xlsx fixtures, with no separate PackageReference of its own.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!--
      Task-authorized (F1-03, DATA-MODEL §2 sanctions ASP.NET Core Identity hashing for
      PasswordHash; nuget.org, MIT): PasswordHasher of TUser's salted PBKDF2-HMACSHA256, wrapped by
      Fidelizar.Infrastructure.Security.IdentityPasswordHasher behind the Domain-level
      IPasswordHasher interface, so Application never references this assembly (ARCHITECTURE §3).
      Core-only package — no EF store, no UserManager, no AspNetUsers table: DATA-MODEL §2 defines
      Usuario as its own lean entity, not the generic Identity user shape.
    -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.9" />
    <!--
      Task-authorized 2026-08-20 (nuget.org, MIT, both first-party .NET extensions packages):
      the two configuration providers FidelizarDbContextFactory needs so that "dotnet ef" reads
      the connection string from the same places the running API does — user secrets, then
      environment variables. Before this, the factory read one environment variable and nothing
      else, which is how tooling and app came to point at different databases.
      Microsoft.Extensions.Configuration itself is already in the graph transitively; only the
      two providers were missing. Pinned to 10.0.9 to match that transitive version and the
      Identity.Core reference above, so no MSB3277 conflict appears.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

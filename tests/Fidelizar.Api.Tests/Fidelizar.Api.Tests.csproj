<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!--
      Owner-authorized (F0-06b, official Microsoft package from nuget.org): boots Fidelizar.Api's
      real pipeline in-memory so RateLimiterPipelineTests proves the rate limiter is actually in
      the pipeline, not merely registered in DI (ARCHITECTURE §8) — today that was only verified
      by hand with curl.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fidelizar.Api\Fidelizar.Api.csproj" />
    <ProjectReference Include="..\..\src\Fidelizar.Client\Fidelizar.Client.csproj" />
  </ItemGroup>

</Project>